{
  "meta": {
    "note": "単語カードの語源パネル用。表示専用。進捗キー・音声・選択肢には使わない。段階3で語根33個まで拡張する。"
  },
  "roots": {
    "spec": {
      "gloss": "見る",
      "origin": "ラテン語 specere",
      "note": "目で見て、対象を見分けるイメージ。",
      "variants": ["spic", "spect"]
    },
    "pos": {
      "gloss": "置く",
      "origin": "ラテン語 ponere",
      "note": "ものを置いて、位置や状態を定めるイメージ。",
      "variants": ["pon"]
    },
    "vert": {
      "gloss": "回す・向ける",
      "origin": "ラテン語 vertere",
      "note": "向きを回して、別の方向へ向けるイメージ。",
      "variants": ["vers"]
    },
    "fer": {
      "gloss": "運ぶ",
      "origin": "ラテン語 ferre",
      "note": "ものを持って別の場所へ運ぶイメージ。"
    },
    "port": {
      "gloss": "運ぶ",
      "origin": "ラテン語 portare",
      "note": "ものを運び、別の場所へ届けるイメージ。"
    },
    "luc": {
      "gloss": "光",
      "origin": "ラテン語 lux（lucis）",
      "note": "光を当てて、見えるようにするイメージ。lucrativeは利益のlucrum由来で、この語根に含めない。",
      "variants": ["lum", "lustr"]
    },
    "duc": {
      "gloss": "導く",
      "origin": "ラテン語 ducere",
      "note": "引いて連れて行くイメージ。",
      "variants": ["duct"]
    },
    "gress": {
      "gloss": "歩む",
      "origin": "ラテン語 gradi",
      "note": "足を進め、歩いて通り抜けるイメージ。",
      "variants": ["grad"]
    },
    "voc": {
      "gloss": "呼ぶ・声",
      "origin": "ラテン語 vocare",
      "note": "声を出して呼ぶイメージ",
      "variants": ["vok"]
    },
    "scrib": {
      "gloss": "書く",
      "origin": "ラテン語 scribere",
      "note": "文字を書き、記録として残すイメージ。",
      "variants": ["script"]
    },
    "nunc": {
      "gloss": "告げる",
      "origin": "ラテン語 nuntiare",
      "note": "知らせを声にして告げるイメージ。",
      "variants": ["nounc"]
    },
    "ven": {
      "gloss": "来る",
      "origin": "ラテン語 venire",
      "note": "こちらへ来て、出会うイメージ。",
      "variants": ["vent"]
    },
    "ced": {
      "gloss": "行く・譲る",
      "origin": "ラテン語 cedere",
      "note": "前へ進む、または場所を譲るイメージ。",
      "variants": ["cess"]
    },
    "cap": {
      "gloss": "取る",
      "origin": "ラテン語 capere",
      "note": "手を伸ばしてつかみ取るイメージ。caput由来のcapital・precipitation・escapeはこの語根に含めない。",
      "variants": ["cept", "cip"]
    },
    "lect": {
      "gloss": "集める・選ぶ",
      "origin": "ラテン語 legere",
      "note": "集めたものから選び取るイメージ。deflect・reflectはflect（曲げる）、relegationはlegare（送る）で、この語根に含めない。",
      "variants": ["leg", "lig"]
    },
    "tract": {
      "gloss": "引く",
      "origin": "ラテン語 trahere",
      "note": "力をかけて引き寄せるイメージ。"
    },
    "quir": {
      "gloss": "求める",
      "origin": "ラテン語 quaerere",
      "note": "答えや情報を求めて探すイメージ。",
      "variants": ["quis", "quest"]
    },
    "plac": {
      "gloss": "なだめる・気に入る",
      "origin": "ラテン語 placere",
      "note": "相手をなだめ、気に入る状態にするイメージ。"
    },
    "cid": {
      "gloss": "切る・落ちる",
      "origin": "ラテン語 caedere / cadere",
      "note": "切り分ける、または落ちることで状態が変わるイメージ。",
      "variants": ["cis"]
    },
    "lev": {
      "gloss": "軽い・上げる",
      "origin": "ラテン語 levis / levare",
      "note": "重さを軽くする、または持ち上げるイメージ。"
    },
    "fac": {
      "gloss": "作る・なす",
      "origin": "ラテン語 facere",
      "note": "ものを作り、行為を成し遂げるイメージ。desertification・ratificationのような-fication語は、未登録の前半まで分解しない。",
      "variants": ["fect", "fic"]
    },
    "her": {
      "gloss": "くっつく",
      "origin": "ラテン語 haerere",
      "note": "ものにくっつき、離れずにとどまるイメージ。heresy・synthesis・synthesize・inheritanceなど、綴りだけが似た語は含めない。",
      "variants": ["hes"]
    },
    "reg": {
      "gloss": "まっすぐにする・支配する",
      "origin": "ラテン語 regere",
      "note": "まっすぐ整え、規則によって導くイメージ。impregnable・insurrection・regurgitateは別語根なので含めない。",
      "variants": ["rect"]
    },
    "nom": {
      "gloss": "名前",
      "origin": "ギリシャ語 onoma / ラテン語 nomen",
      "note": "名前を付け、名前で呼ぶイメージ。",
      "variants": ["nym"]
    },
    "gen": {
      "gloss": "生む・種",
      "origin": "ラテン語 gignere / genus",
      "note": "生み出され、同じ種や系統につながるイメージ。",
      "variants": ["gener"]
    },
    "sist": {
      "gloss": "立つ",
      "origin": "ラテン語 sistere / stare",
      "note": "その場に立たせ、状態を保つイメージ。",
      "variants": ["stit", "sta"]
    },
    "grat": {
      "gloss": "喜ばせる・感謝",
      "origin": "ラテン語 gratus / gratia",
      "note": "喜びや好意を与え、ありがたく思うイメージ。",
      "variants": ["grac"]
    },
    "log": {
      "gloss": "言葉・話す",
      "origin": "ギリシャ語 logos / ラテン語 loqui",
      "note": "言葉を使って話し、考えを表すイメージ。",
      "variants": ["loqu", "locut"]
    },
    "val": {
      "gloss": "強い・価値がある",
      "origin": "ラテン語 valere",
      "note": "力があり、価値を持つイメージ。"
    },
    "vid": {
      "gloss": "見える",
      "origin": "ラテン語 videre",
      "note": "視界に入り、見える状態になるイメージ。specは注意して見る語根で、視覚に入る語とは分ける。",
      "variants": ["vis"]
    },
    "cord": {
      "gloss": "心",
      "origin": "ラテン語 cor / cordis",
      "note": "心や気持ちの中心に関わるイメージ。"
    },
    "tang": {
      "gloss": "触れる",
      "origin": "ラテン語 tangere",
      "note": "手や感覚で触れて確かめるイメージ。",
      "variants": ["tact"]
    },
    "cur": {
      "gloss": "走る",
      "origin": "ラテン語 currere",
      "note": "走って進み、流れや経過が続くイメージ。",
      "variants": ["curr"]
    }
  },
  "affixes": {
    "equi": { "gloss": "等しい", "kind": "prefix" },
    "e": { "gloss": "外へ", "kind": "prefix" },
    "-ate": { "gloss": "〜にする（動詞化）", "kind": "suffix" },
    "-ative": { "gloss": "〜する性質の", "kind": "suffix" },
    "in": { "gloss": "中へ・否定", "kind": "prefix", "note": "場所なら「中へ」、否定なら「〜でない」の意味を選ぶ。b・m・pの前ではimになる。" },
    "im": { "gloss": "中へ・否定", "kind": "prefix", "note": "inの異形。b・m・pの前で使う（impel・immigration）。意味の選び方はinと同じ。" },
    "re": { "gloss": "再び・後ろへ", "kind": "prefix", "note": "語によって「再び」「元へ・後ろへ」「取り消して」を選ぶ。" },
    "de": { "gloss": "下へ・離れて・完全に", "kind": "prefix" },
    "con": { "gloss": "ともに・完全に", "kind": "prefix", "note": "b・m・pの前ではcomになる。" },
    "com": { "gloss": "ともに・完全に", "kind": "prefix", "note": "conの異形。b・m・pの前で使う（commission・compose）。" },
    "dis": { "gloss": "離れて・否定", "kind": "prefix" },
    "pro": { "gloss": "前へ", "kind": "prefix" },
    "ex": { "gloss": "外へ", "kind": "prefix", "note": "子音の前ではeになる（evoke・emanate）。" },
    "sub": { "gloss": "下へ・副次的に", "kind": "prefix" },
    "per": { "gloss": "通して・徹底的に", "kind": "prefix" },
    "pre": { "gloss": "前もって", "kind": "prefix" },
    "-ion": { "gloss": "〜すること（名詞化）", "kind": "suffix" },
    "-ive": { "gloss": "〜する性質の", "kind": "suffix" },
    "-ous": { "gloss": "〜に満ちた", "kind": "suffix" },
    "-ify": { "gloss": "〜にする（facere＝作る から）", "kind": "suffix" },
    "a": {
      "gloss": "〜へ・離れて",
      "kind": "prefix",
      "note": "語によってab-由来の「離れて」とad-由来の「〜へ」を選ぶ。"
    },
    "ad": { "gloss": "〜へ・近くへ", "kind": "prefix" },
    "ac": { "gloss": "〜へ・近くへ", "kind": "prefix" },
    "ag": { "gloss": "〜へ・向かって", "kind": "prefix" },
    "al": { "gloss": "〜へ・完全に", "kind": "prefix" },
    "an": { "gloss": "〜へ・上に", "kind": "prefix" },
    "co": { "gloss": "ともに", "kind": "prefix" },
    "col": { "gloss": "ともに", "kind": "prefix" },
    "contra": { "gloss": "反対に", "kind": "prefix" },
    "di": { "gloss": "分けて・離れて", "kind": "prefix" },
    "en": { "gloss": "中へ・完全に", "kind": "prefix" },
    "il": { "gloss": "中へ・上に", "kind": "prefix" },
    "intra": { "gloss": "内側へ", "kind": "prefix" },
    "juxta": { "gloss": "そばに", "kind": "prefix" },
    "neg": { "gloss": "否定して", "kind": "prefix" },
    "post": { "gloss": "後へ", "kind": "prefix" },
    "suc": { "gloss": "後から", "kind": "prefix" },
    "suf": { "gloss": "下から", "kind": "prefix" },
    "sup": { "gloss": "下に", "kind": "prefix" },
    "sus": { "gloss": "下から", "kind": "prefix" },
    "intro": { "gloss": "内側へ", "kind": "prefix" },
    "retro": { "gloss": "後ろへ", "kind": "prefix" },
    "trans": { "gloss": "越えて", "kind": "prefix" },
    "dif": { "gloss": "離れて・否定", "kind": "prefix", "note": "disの異形。fの前で使う。" },
    "super": { "gloss": "上に・超えて", "kind": "prefix" },
    "sur": { "gloss": "上に", "kind": "prefix" },
    "mis": { "gloss": "誤って", "kind": "prefix" },
    "pseudo": { "gloss": "偽りの", "kind": "prefix" },
    "auto": { "gloss": "自分で", "kind": "prefix" },
    "ambi": { "gloss": "両方に", "kind": "prefix" },
    "apo": { "gloss": "〜から離れて", "kind": "prefix" },
    "oc": { "gloss": "向かって", "kind": "prefix", "note": "obの同化形。cの前で使う。" },
    "-al": { "gloss": "〜に関する", "kind": "suffix" },
    "-men": { "gloss": "〜したもの", "kind": "suffix" },
    "-ant": { "gloss": "〜するもの・人", "kind": "suffix" },
    "-ator": { "gloss": "〜する人", "kind": "suffix" },
    "-ation": { "gloss": "〜すること", "kind": "suffix" },
    "-ency": { "gloss": "〜の状態", "kind": "suffix" },
    "-ent": { "gloss": "〜するもの・人", "kind": "suffix" },
    "-ential": { "gloss": "〜に関する", "kind": "suffix" },
    "-er": { "gloss": "〜する人", "kind": "suffix" },
    "-ical": { "gloss": "〜の性質の", "kind": "suffix" },
    "-ible": { "gloss": "〜できる", "kind": "suffix" },
    "-ity": { "gloss": "〜であること", "kind": "suffix" },
    "-ite": { "gloss": "〜されたもの", "kind": "suffix" },
    "-ment": { "gloss": "〜すること・もの", "kind": "suffix" },
    "-or": { "gloss": "〜する人・もの", "kind": "suffix" },
    "-ture": { "gloss": "〜すること・もの", "kind": "suffix" },
    "-ure": { "gloss": "〜すること・もの", "kind": "suffix" },
    "-ful": { "gloss": "〜に満ちた", "kind": "suffix" },
    "-ize": { "gloss": "〜にする", "kind": "suffix" },
    "-escence": { "gloss": "〜の過程・状態", "kind": "suffix" }
  }
}
