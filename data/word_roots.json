{
  "meta": {
    "note": "単語カードの語源パネル用。表示専用。進捗キー・音声・選択肢には使わない。段階5バッチ2で語根71個まで拡張する。"
  },
  "roots": {
    "spec": {
      "gloss": "見る",
      "origin": "ラテン語 specere",
      "note": "目で見て、対象を見分けるイメージ。",
      "variants": ["spic", "spect"]
    },
    "pos": {
      "gloss": "置く",
      "origin": "ラテン語 ponere",
      "note": "ものを置いて、位置や状態を定めるイメージ。",
      "variants": ["pon"]
    },
    "vert": {
      "gloss": "回す・向ける",
      "origin": "ラテン語 vertere",
      "note": "向きを回して、別の方向へ向けるイメージ。",
      "variants": ["vers"]
    },
    "fer": {
      "gloss": "運ぶ",
      "origin": "ラテン語 ferre",
      "note": "ものを持って別の場所へ運ぶイメージ。"
    },
    "port": {
      "gloss": "運ぶ",
      "origin": "ラテン語 portare",
      "note": "ものを運び、別の場所へ届けるイメージ。"
    },
    "luc": {
      "gloss": "光",
      "origin": "ラテン語 lux（lucis）",
      "note": "光を当てて、見えるようにするイメージ。lucrativeは利益のlucrum由来で、この語根に含めない。",
      "variants": ["lum", "lustr"]
    },
    "duc": {
      "gloss": "導く",
      "origin": "ラテン語 ducere",
      "note": "引いて連れて行くイメージ。",
      "variants": ["duct"]
    },
    "gress": {
      "gloss": "歩む",
      "origin": "ラテン語 gradi",
      "note": "足を進め、歩いて通り抜けるイメージ。",
      "variants": ["grad", "gred"]
    },
    "voc": {
      "gloss": "呼ぶ・声",
      "origin": "ラテン語 vocare",
      "note": "声を出して呼ぶイメージ",
      "variants": ["vok"]
    },
    "scrib": {
      "gloss": "書く",
      "origin": "ラテン語 scribere",
      "note": "文字を書き、記録として残すイメージ。",
      "variants": ["script"]
    },
    "nunc": {
      "gloss": "告げる",
      "origin": "ラテン語 nuntiare",
      "note": "知らせを声にして告げるイメージ。",
      "variants": ["nounc"]
    },
    "ven": {
      "gloss": "来る",
      "origin": "ラテン語 venire",
      "note": "こちらへ来て、出会うイメージ。",
      "variants": ["vent"]
    },
    "ced": {
      "gloss": "行く・譲る",
      "origin": "ラテン語 cedere",
      "note": "前へ進む、または場所を譲るイメージ。",
      "variants": ["cess"]
    },
    "cap": {
      "gloss": "取る",
      "origin": "ラテン語 capere",
      "note": "手を伸ばしてつかみ取るイメージ。caput由来のcapital・precipitation・escapeはこの語根に含めない。",
      "variants": ["cept", "cip"]
    },
    "lect": {
      "gloss": "集める・選ぶ",
      "origin": "ラテン語 legere",
      "note": "集めたものから選び取るイメージ。deflect・reflectはflect（曲げる）、relegationはlegare（送る）で、この語根に含めない。",
      "variants": ["leg", "lig"]
    },
    "tract": {
      "gloss": "引く",
      "origin": "ラテン語 trahere",
      "note": "力をかけて引き寄せるイメージ。"
    },
    "quir": {
      "gloss": "求める",
      "origin": "ラテン語 quaerere",
      "note": "答えや情報を求めて探すイメージ。",
      "variants": ["quis", "quest"]
    },
    "plac": {
      "gloss": "なだめる・気に入る",
      "origin": "ラテン語 placere",
      "note": "相手をなだめ、気に入る状態にするイメージ。"
    },
    "cid": {
      "gloss": "切る・落ちる",
      "origin": "ラテン語 caedere / cadere",
      "note": "切り分ける、または落ちることで状態が変わるイメージ。",
      "variants": ["cis"]
    },
    "lev": {
      "gloss": "軽い・上げる",
      "origin": "ラテン語 levis / levare",
      "note": "重さを軽くする、または持ち上げるイメージ。alleviate・elevate・relief。",
      "variants": ["liev"]
    },
    "fac": {
      "gloss": "作る・なす",
      "origin": "ラテン語 facere",
      "note": "ものを作り、行為を成し遂げるイメージ。desertification・ratificationのような-fication語は、未登録の前半まで分解しない。",
      "variants": ["fect", "fic"]
    },
    "her": {
      "gloss": "くっつく",
      "origin": "ラテン語 haerere",
      "note": "ものにくっつき、離れずにとどまるイメージ。heresy・synthesis・synthesize・inheritanceなど、綴りだけが似た語は含めない。",
      "variants": ["hes"]
    },
    "reg": {
      "gloss": "まっすぐにする・支配する",
      "origin": "ラテン語 regere",
      "note": "まっすぐ整え、規則によって導くイメージ。impregnable・insurrection・regurgitateは別語根なので含めない。",
      "variants": ["rect"]
    },
    "nom": {
      "gloss": "名前",
      "origin": "ギリシャ語 onoma / ラテン語 nomen",
      "note": "名前を付け、名前で呼ぶイメージ。",
      "variants": ["nym"]
    },
    "gen": {
      "gloss": "生む・種",
      "origin": "ラテン語 gignere / genus",
      "note": "生み出され、同じ種や系統につながるイメージ。",
      "variants": ["gener"]
    },
    "sist": {
      "gloss": "立つ",
      "origin": "ラテン語 sistere / stare",
      "note": "その場に立たせ、状態を保つイメージ。",
      "variants": ["stit", "sta"]
    },
    "grat": {
      "gloss": "喜ばせる・感謝",
      "origin": "ラテン語 gratus / gratia",
      "note": "喜びや好意を与え、ありがたく思うイメージ。",
      "variants": ["grac"]
    },
    "log": {
      "gloss": "言葉・話す",
      "origin": "ギリシャ語 logos / ラテン語 loqui",
      "note": "言葉を使って話し、考えを表すイメージ。",
      "variants": ["loqu", "locut"]
    },
    "val": {
      "gloss": "強い・価値がある",
      "origin": "ラテン語 valere",
      "note": "力があり、価値を持つイメージ。"
    },
    "vid": {
      "gloss": "見える",
      "origin": "ラテン語 videre",
      "note": "視界に入り、見える状態になるイメージ。specは注意して見る語根で、視覚に入る語とは分ける。",
      "variants": ["vis"]
    },
    "cord": {
      "gloss": "心",
      "origin": "ラテン語 cor / cordis",
      "note": "心や気持ちの中心に関わるイメージ。"
    },
    "tang": {
      "gloss": "触れる",
      "origin": "ラテン語 tangere",
      "note": "手や感覚で触れて確かめるイメージ。",
      "variants": ["tact"]
    },
    "cur": {
      "gloss": "走る",
      "origin": "ラテン語 currere",
      "note": "走って進み、流れや経過が続くイメージ。",
      "variants": ["curr"]
    },
    "carcer": {
      "gloss": "牢屋",
      "origin": "ラテン語 carcer",
      "note": "閉じた場所に収容するイメージ。incarceration。"
    },
    "clem": {
      "gloss": "穏やか",
      "origin": "ラテン語 clemens",
      "note": "穏やかで、厳しくない状態のイメージ。clemency。"
    },
    "pet": {
      "gloss": "求める",
      "origin": "ラテン語 petere",
      "note": "何かを求めて向かうイメージ。appetite・compete。",
      "variants": ["peat"]
    },
    "cumb": {
      "gloss": "横たわる",
      "origin": "ラテン語 cumbere",
      "note": "横たわり、その上に重なるイメージ。succumb。"
    },
    "dic": {
      "gloss": "言う",
      "origin": "ラテン語 dicere",
      "note": "言葉にして告げるイメージ。dictionary・verdict。",
      "variants": ["dict"]
    },
    "cre": {
      "gloss": "ふるい分ける",
      "origin": "ラテン語 cernere",
      "note": "見分けて、ふるい分けるイメージ。discretion・discreetly。"
    },
    "dol": {
      "gloss": "痛む",
      "origin": "ラテン語 dolere",
      "note": "痛みや悲しみを感じるイメージ。condolence。"
    },
    "fall": {
      "gloss": "だます",
      "origin": "ラテン語 fallere",
      "note": "人の判断を誤らせるイメージ。fallacy・false。"
    },
    "flu": {
      "gloss": "流れる",
      "origin": "ラテン語 fluere",
      "note": "水や力が流れ込むイメージ。fluctuate・fluent。"
    },
    "fract": {
      "gloss": "壊す",
      "origin": "ラテン語 frangere",
      "note": "固いものを折り、壊すイメージ。fragment・fragile。",
      "variants": ["fring"]
    },
    "nat": {
      "gloss": "生まれる",
      "origin": "ラテン語 nasci",
      "note": "生まれ、もともとの性質として現れるイメージ。native・nation。-ationだけの一致は含めない。"
    },
    "noc": {
      "gloss": "害する",
      "origin": "ラテン語 nocere",
      "note": "害を与え、傷つけるイメージ。innocuous・obnoxious。"
    },
    "nov": {
      "gloss": "新しい",
      "origin": "ラテン語 novus",
      "note": "新しく生まれ変わるイメージ。novel・renovate。"
    },
    "sign": {
      "gloss": "印",
      "origin": "ラテン語 signum",
      "note": "印を付けて、意味を示すイメージ。assignment・consignment。"
    },
    "sip": {
      "gloss": "味わう",
      "origin": "ラテン語 sapere",
      "note": "味を知り、賢く判断するイメージ。savory・sapient。"
    },
    "act": {
      "gloss": "行う",
      "origin": "ラテン語 agere",
      "note": "動かし、行為として実行するイメージ。action・agent。"
    },
    "trep": {
      "gloss": "おののく",
      "origin": "ラテン語 trepidus",
      "note": "恐れで身が震えるイメージ。trepidation。"
    },
    "tric": {
      "gloss": "もつれ",
      "origin": "ラテン語 tricae",
      "note": "複雑に絡み、ほどきにくくなるイメージ。extricate。",
      "variants": ["trig"]
    },
    "vad": {
      "gloss": "行く",
      "origin": "ラテン語 vadere",
      "note": "ある方向へ進んで行くイメージ。evade・invasion。"
    },
    "vestig": {
      "gloss": "足跡",
      "origin": "ラテン語 vestigium",
      "note": "残された足跡をたどって調べるイメージ。vestige。"
    },
    "vigor": {
      "gloss": "活力",
      "origin": "ラテン語 vigor",
      "note": "力強く、生き生きしている状態のイメージ。vigorous。"
    },
    "claim": {
      "gloss": "叫ぶ",
      "origin": "ラテン語 clamare",
      "note": "声に出して主張するイメージ。acclaim・proclaim。"
    },
    "und": {
      "gloss": "波",
      "origin": "ラテン語 unda",
      "note": "波のようにあふれ、余るイメージ。inundate・abundant。"
    },
    "flect": {
      "gloss": "曲げる",
      "origin": "ラテン語 flectere",
      "note": "向きを曲げて、跳ね返すイメージ。deflect・flexible。",
      "variants": ["flex"]
    },
    "ject": {
      "gloss": "投げる",
      "origin": "ラテン語 jacere",
      "note": "ものを投げ出し、遠ざけるイメージ。project・inject。"
    },
    "med": {
      "gloss": "癒す",
      "origin": "ラテン語 mederi",
      "note": "必要な手当てをして、状態を治すイメージ。remedy・medical。"
    },
    "patri": {
      "gloss": "父・祖国",
      "origin": "ラテン語 patria",
      "note": "父祖の土地を自分の国と捉えるイメージ。patriot・expatriate。"
    },
    "pris": {
      "gloss": "つかむ",
      "origin": "ラテン語 prehendere",
      "note": "手でつかみ、取り返すイメージ。surprisingly・prison。"
    },
    "rept": {
      "gloss": "這う",
      "origin": "ラテン語 repere",
      "note": "地面をはって進むイメージ。reptilian。"
    },
    "puls": {
      "gloss": "押す",
      "origin": "ラテン語 pellere",
      "note": "力を加えて押し返すイメージ。impel・expel。",
      "variants": ["pel"]
    },
    "scind": {
      "gloss": "裂く",
      "origin": "ラテン語 scindere",
      "note": "切り裂いて、元の状態を断つイメージ。rescission。"
    },
    "sent": {
      "gloss": "感じる",
      "origin": "ラテン語 sentire",
      "note": "感じ取ったことを心に受け止めるイメージ。sentiment・consensual。"
    },
    "sal": {
      "gloss": "跳ぶ",
      "origin": "ラテン語 salire",
      "note": "跳ね返り、元の位置へ戻るイメージ。salient・assail。",
      "variants": ["sil"]
    },
    "son": {
      "gloss": "響く",
      "origin": "ラテン語 sonare",
      "note": "音を出し、響かせるイメージ。sonic・resonance。"
    },
    "ten": {
      "gloss": "保つ",
      "origin": "ラテン語 tenere",
      "note": "手に持ち、状態を保つイメージ。tenure・retain。"
    },
    "trib": {
      "gloss": "割り当てる",
      "origin": "ラテン語 tribuere",
      "note": "人や集団に分け与えるイメージ。contribute・tribute。"
    },
    "vel": {
      "gloss": "覆う",
      "origin": "ラテン語 velare",
      "note": "覆いを外して、隠れたものを見せるイメージ。reveal・veil。"
    },
    "prim": {
      "gloss": "押す",
      "origin": "ラテン語 premere",
      "note": "押さえつけて抑えるイメージ。oppress。primus（第一）由来の語は含めない。"
    }
  },
  "affixes": {
    "equi": { "gloss": "等しい", "kind": "prefix" },
    "e": { "gloss": "外へ", "kind": "prefix" },
    "-ate": { "gloss": "〜にする（動詞化）", "kind": "suffix" },
    "-ative": { "gloss": "〜する性質の", "kind": "suffix" },
    "in": { "gloss": "中へ・否定", "kind": "prefix", "note": "場所なら「中へ」、否定なら「〜でない」の意味を選ぶ。b・m・pの前ではimになる。" },
    "im": { "gloss": "中へ・否定", "kind": "prefix", "note": "inの異形。b・m・pの前で使う（impel・immigration）。意味の選び方はinと同じ。" },
    "re": { "gloss": "再び・後ろへ", "kind": "prefix", "note": "語によって「再び」「元へ・後ろへ」「取り消して」を選ぶ。" },
    "de": { "gloss": "下へ・離れて・完全に", "kind": "prefix" },
    "con": { "gloss": "ともに・完全に", "kind": "prefix", "note": "b・m・pの前ではcomになる。" },
    "com": { "gloss": "ともに・完全に", "kind": "prefix", "note": "conの異形。b・m・pの前で使う（commission・compose）。" },
    "dis": { "gloss": "離れて・否定", "kind": "prefix" },
    "pro": { "gloss": "前へ", "kind": "prefix" },
    "ex": { "gloss": "外へ", "kind": "prefix", "note": "子音の前ではeになる（evoke・emanate）。" },
    "sub": { "gloss": "下へ・副次的に", "kind": "prefix" },
    "per": { "gloss": "通して・徹底的に", "kind": "prefix" },
    "pre": { "gloss": "前もって", "kind": "prefix" },
    "-ion": { "gloss": "〜すること（名詞化）", "kind": "suffix" },
    "-ive": { "gloss": "〜する性質の", "kind": "suffix" },
    "-ous": { "gloss": "〜に満ちた", "kind": "suffix" },
    "-ify": { "gloss": "〜にする（facere＝作る から）", "kind": "suffix" },
    "a": {
      "gloss": "〜へ・離れて",
      "kind": "prefix",
      "note": "語によってab-由来の「離れて」とad-由来の「〜へ」を選ぶ。"
    },
    "ad": { "gloss": "〜へ・近くへ", "kind": "prefix" },
    "ac": { "gloss": "〜へ・近くへ", "kind": "prefix" },
    "ag": { "gloss": "〜へ・向かって", "kind": "prefix" },
    "al": { "gloss": "〜へ・完全に", "kind": "prefix" },
    "an": { "gloss": "〜へ・上に", "kind": "prefix" },
    "co": { "gloss": "ともに", "kind": "prefix" },
    "col": { "gloss": "ともに", "kind": "prefix" },
    "contra": { "gloss": "反対に", "kind": "prefix" },
    "di": { "gloss": "分けて・離れて", "kind": "prefix" },
    "en": { "gloss": "中へ・完全に", "kind": "prefix" },
    "il": { "gloss": "中へ・上に", "kind": "prefix" },
    "intra": { "gloss": "内側へ", "kind": "prefix" },
    "inter": { "gloss": "間の・相互に", "kind": "prefix" },
    "juxta": { "gloss": "そばに", "kind": "prefix" },
    "neg": { "gloss": "否定して", "kind": "prefix" },
    "post": { "gloss": "後へ", "kind": "prefix" },
    "suc": { "gloss": "後から", "kind": "prefix" },
    "suf": { "gloss": "下から", "kind": "prefix" },
    "sup": { "gloss": "下に", "kind": "prefix" },
    "sus": { "gloss": "下から", "kind": "prefix" },
    "intro": { "gloss": "内側へ", "kind": "prefix" },
    "retro": { "gloss": "後ろへ", "kind": "prefix" },
    "trans": { "gloss": "越えて", "kind": "prefix" },
    "dif": { "gloss": "離れて・否定", "kind": "prefix", "note": "disの異形。fの前で使う。" },
    "super": { "gloss": "上に・超えて", "kind": "prefix" },
    "sur": { "gloss": "上に", "kind": "prefix" },
    "mis": { "gloss": "誤って", "kind": "prefix" },
    "pseudo": { "gloss": "偽りの", "kind": "prefix" },
    "auto": { "gloss": "自分で", "kind": "prefix" },
    "ambi": { "gloss": "両方に", "kind": "prefix" },
    "apo": { "gloss": "〜から離れて", "kind": "prefix" },
    "oc": { "gloss": "向かって", "kind": "prefix", "note": "obの同化形。cの前で使う。" },
    "-al": { "gloss": "〜に関する", "kind": "suffix" },
    "-men": { "gloss": "〜したもの", "kind": "suffix" },
    "-ant": { "gloss": "〜するもの・人", "kind": "suffix" },
    "-ator": { "gloss": "〜する人", "kind": "suffix" },
    "-ation": { "gloss": "〜すること", "kind": "suffix" },
    "-ency": { "gloss": "〜の状態", "kind": "suffix" },
    "-ence": { "gloss": "〜の状態", "kind": "suffix" },
    "-ent": { "gloss": "〜するもの・人", "kind": "suffix" },
    "-ential": { "gloss": "〜に関する", "kind": "suffix" },
    "-er": { "gloss": "〜する人", "kind": "suffix" },
    "-ical": { "gloss": "〜の性質の", "kind": "suffix" },
    "-ible": { "gloss": "〜できる", "kind": "suffix" },
    "-ity": { "gloss": "〜であること", "kind": "suffix" },
    "-id": { "gloss": "〜の性質の", "kind": "suffix" },
    "-ite": { "gloss": "〜されたもの", "kind": "suffix" },
    "-ment": { "gloss": "〜すること・もの", "kind": "suffix" },
    "-or": { "gloss": "〜する人・もの", "kind": "suffix" },
    "-ture": { "gloss": "〜すること・もの", "kind": "suffix" },
    "-ure": { "gloss": "〜すること・もの", "kind": "suffix" },
    "-ful": { "gloss": "〜に満ちた", "kind": "suffix" },
    "-ize": { "gloss": "〜にする", "kind": "suffix" },
    "-ly": { "gloss": "〜な状態で", "kind": "suffix" },
    "-escence": { "gloss": "〜の過程・状態", "kind": "suffix" },
    "-ile": { "gloss": "〜するもの・〜の性質の", "kind": "suffix" }
  }
}
